# Copy to .env. Never commit .env. Generate the secrets with:  node scripts/gen-secrets.mjs
# Public domain Caddy serves (DNS A record -> the VPS), e.g. replog.example.com
DOMAIN=

# Supabase (generated by scripts/gen-secrets.mjs). Do not change them after the first start:
# POSTGRES_PASSWORD is stored in the database volume, and the keys are signed with JWT_SECRET.
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=

# Optional: close registration once your account exists.
DISABLE_SIGNUP=false

# Optional: e-mail (confirmation, e-mail change). Without SMTP keep MAILER_AUTOCONFIRM=true.
MAILER_AUTOCONFIRM=true
SMTP_ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional: food search fallback.
USDA_API_KEY=

# Optional: automatic Google Drive backup (the card in Settings stays hidden without all of these).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://<your-domain>/api/drive/callback
DRIVE_TOKEN_KEY=
CRON_SECRET=
