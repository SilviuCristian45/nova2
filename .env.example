# Copy to .env. Never commit .env.
# Public domain Caddy serves (DNS A record -> the VPS), e.g. replog.example.com
DOMAIN=

# Supabase. NEXT_PUBLIC_* are baked into the browser bundle at build time: rebuild the image after changing them.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Needed for barcode scanning, account deletion and Drive backup.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: food search fallback.
USDA_API_KEY=

# Optional: automatic Google Drive backup (the card in Settings stays hidden without all of these).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://<your-domain>/api/drive/callback
DRIVE_TOKEN_KEY=      # openssl rand -base64 32
CRON_SECRET=          # openssl rand -hex 32
